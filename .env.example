# Copy to .env and fill in. Every setting the API reads is listed here.

# --- Core
DATABASE_URL=postgres://user:password@host:5432/thrive_gym?sslmode=require
# Must be free on the server: Fitlab's API uses 43123, Bright's 43124.
PORT=43125
NODE_ENV=production
# Shared with the desktop app's sync settings
API_KEY_SECRET=
# Signs admin logins; long and random
JWT_SECRET=
# First web-admin login, created on first start when no admin exists. In production
# nothing is created without these. Change later with `npm run update:admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Temporary password for manager/trainer/member logins created from desktop sync and
# for staff password resets (defaults to 0000). It is stored only as a bcrypt hash and
# every account holding it must choose a new password at next sign-in.
DEFAULT_PASSWORD=

# --- SMS (AfroMessage)
AFRO_TOKEN=
AFRO_SENDER_NAME=
AFRO_IDENTIFIER_ID=
AFRO_CALLBACK_BASE_URL=

# --- Notifications
# Dates in notifications are shown in this timezone, amounts in this currency.
APP_TIMEZONE=Africa/Addis_Ababa
APP_CURRENCY=ETB
# Notifications older than this many days are deleted (default 180).
NOTIFICATION_RETENTION_DAYS=180

# Web Push. Generate the pair once with `npx web-push generate-vapid-keys` and keep it:
# changing it signs every subscribed browser out of push. Without these, push is off and
# in-app notifications still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address the push services can reach (Apple requires one).
VAPID_SUBJECT=mailto:admin@thrivegym.com
# Extra push service hosts to accept, comma-separated (the major browsers' are built in).
PUSH_ENDPOINT_HOSTS=
